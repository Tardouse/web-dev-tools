{
  "name": "web-dev-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fast, privacy-first toolbox for developers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "./scripts/start.sh",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "bcryptjs": "^3.0.3",
    "croner": "10.0.1",
    "diff": "9.0.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "prettier": "3.9.6",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
