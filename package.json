{
  "name": "web-dev-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fast, privacy-first toolbox for developers.",
  "scripts": {
    "dev": "next dev -p 8886",
    "build": "next build",
    "start": "./scripts/start.sh",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "bcryptjs": "^3.0.3",
    "chardet": "2.2.0",
    "croner": "10.0.1",
    "csso": "5.0.5",
    "diff": "9.0.0",
    "exifr": "7.1.3",
    "fast-xml-parser": "5.11.0",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.31.0",
    "micro-key-producer": "0.10.0",
    "mime-db": "1.54.0",
    "modern-tar": "0.8.4",
    "next": "16.3.1",
    "nodemailer": "9.0.5",
    "papaparse": "5.6.0",
    "prettier": "3.9.6",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sql-formatter": "15.8.2",
    "terser": "5.50.0",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/csso": "5.0.5",
    "@types/mime-db": "1.43.6",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
