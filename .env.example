# Public canonical URL used for metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://tools.example.com

# Writable SQLite database path. The Compose volume mounts /data persistently.
DATABASE_PATH=/data/devtoolbox.sqlite

# Used once to create the first Super Admin when the database has none.
# Use a unique 12+ character password with upper/lowercase, number, and symbol.
ADMIN_USERNAME=admin
ADMIN_NAME=DevToolbox Admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Production email delivery for verification and password recovery.
MAIL_TRANSPORT=smtp
MAIL_FROM="DevToolbox <no-reply@tools.example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# Host port exposed by Docker Compose.
APP_PORT=8886

# Optional image name/tag for deployments.
IMAGE_NAME=web-dev-tools
IMAGE_TAG=latest
